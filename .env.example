# Crie uma chave no projeto gratuito do Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: diretório absoluto de dados. O padrão é ./data.
# CEARA_DATA_DIR=/caminho/para/dados

# Perfil local padrão: integral. Na Vercel, CEARA_PUBLIC=1 mantém as proteções.
# CEARA_DATA_PROFILE=integral
# CEARA_PUBLIC=1
# PUBLIC_RESPONSAVEL=
# PUBLIC_PRIVACY_EMAIL=
