# Execução local: cada usuário fornece sua própria chave do Google AI Studio.
# Vercel: configure GEMINI_API_KEY como segredo de ambiente do projeto;
# visitantes usam a chave do responsável, sem recebê-la no navegador.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: diretório absoluto de dados. O padrão é ./data.
# CEARA_DATA_DIR=/caminho/para/dados

# Perfil local padrão: integral. Na Vercel, CEARA_PUBLIC=1 exige o perfil minimizado.
# CEARA_DATA_PROFILE=integral
# Na publicação: CEARA_DATA_PROFILE=minimizado
# CEARA_PUBLIC=1
# PUBLIC_RESPONSAVEL=
# PUBLIC_PRIVACY_EMAIL=
